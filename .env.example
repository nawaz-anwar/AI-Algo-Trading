# Delta Exchange
DELTA_BASE_URL=https://cdn-ind.testnet.deltaex.org
# Switch to production when ready:
# DELTA_BASE_URL=https://api.india.delta.exchange

# Redis (task queue only – no DB)
REDIS_URL=redis://redis:6379/0

# Encryption key for Delta API secrets (AES-256)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_generated_fernet_key_here

# Firebase (set in frontend .env)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=yourapp.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=yourapp.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:web:abcdef

# Backend API URL
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=wss://socket.india.delta.exchange
